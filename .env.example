# Girisimco — Environment Variables

# Supabase (required for auth + data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL for auth email redirects (production custom domain)
# Optional on Vercel Preview — VERCEL_URL is used automatically when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# İkinciBazar (legacy product — separate from Girisimco auth)
NEXT_PUBLIC_OWNER_TOKEN=demo-token

# Edge functions only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
