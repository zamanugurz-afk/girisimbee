# Girisimbee — Environment Variables

# Supabase (required for auth + data) — MUST match Google Cloud redirect host exactly
NEXT_PUBLIC_SUPABASE_URL=https://tszvmnaejsxsyuawwclr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Auth redirects while custom-domain DNS is unstable: use the Vercel alias
NEXT_PUBLIC_SITE_URL=https://girisimbee.vercel.app

# Public site gate: maintenance | live
# Local: leave unset or "live". Production defaults to maintenance until launch.
# When ready to open publicly: set NEXT_PUBLIC_SITE_MODE=live on Vercel AND clear SITE_IP_ALLOWLIST.
NEXT_PUBLIC_SITE_MODE=live

# Optional IP preview: comma-separated public IPs that may see the live site.
# When set, production is live for those IPs only; everyone else sees /bakim.
# SITE_IP_ALLOWLIST=1.2.3.4

# İkinciBazar (legacy product — separate from Girisimbee auth)
NEXT_PUBLIC_OWNER_TOKEN=demo-token

# Server-only Supabase service role (never expose to client)
# Prefer SUPABASE_SERVICE_ROLE_KEY. SUPABASE_SECRET_KEY is accepted as a fallback alias.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=

# Transactional email — Resend preferred; SMTP used as fallback (password reset, etc.)
RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM="Girisimbee <info@girisimbee.com>"
# RESEND_FROM="Girisimbee <info@girisimbee.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Girisimbee <info@girisimbee.com>"
# SMTP_SECURE=false

# Phone OTP HMAC secret (required in production; never use anon key)
PHONE_OTP_SECRET=your-long-random-phone-otp-secret

# iyzico payment provider (P0 — server-side only)
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
